{
  "name": "@luma/server",
  "version": "0.1.0",
  "private": true,
  "description": "Luma 服务端：鉴权、上传、数据接口、教学 Agent 与任务执行",
  "scripts": {
    "dev": "next dev -p 4000",
    "build": "next build",
    "start": "next start -p 4000",
    "worker": "tsx src/worker/index.ts",
    "worker:dev": "tsx watch src/worker/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "test:local": "tsx scripts/local-smoke.ts",
    "test:runtime": "tsx scripts/runtime-check.ts",
    "test:migration": "tsx scripts/migration-check.ts",
    "test:subjects": "tsx scripts/subjects-check.ts",
    "test:practice": "tsx scripts/practice-check.ts",
    "test:reading": "tsx scripts/reading-check.ts",
    "test:reading:live": "tsx scripts/reading-live-check.ts",
    "test:context": "tsx scripts/context-check.ts",
    "test:memory": "tsx scripts/memory-check.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.0",
    "@luma/shared": "workspace:*",
    "@next/env": "15.5.28",
    "@prisma/client": "^6.16.0",
    "ai": "^5.0.0",
    "js-tiktoken": "^1.0.21",
    "katex": "^0.16.21",
    "mathjax-full": "3.2.2",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "0.34.5",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "^6.16.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
