// Luma 数据模型 —— 对应 docs/design/data-api.md。
// 字段命名与文档术语一致；业务约束（版本唯一、收藏唯一、轮次+题目唯一等）见文件末尾。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubjectType {
  question
  knowledge
}

enum TeachingStage {
  clarifying
  guiding
  explaining
  practicing
  reviewing
}

enum PracticeStage {
  intro
  doing
  review
  summary
}

enum JobStatus {
  queued
  running
  succeeded
  failed
  cancelled
  superseded
}

enum ArtifactType {
  lesson
  exercise_set
}

enum PublishStatus {
  generating
  published
  failed
}

enum MessageRole {
  user
  assistant
}

enum MessageStatus {
  complete
  incomplete
}

enum SelfEval {
  independent
  partial
  stuck
}

enum ReviewStatus {
  to_review
  reviewed
}

enum AttachmentPurpose {
  question_origin
  process_photo
  answer_photo
  lesson_illustration
  knowledge_material
}

/// 微信身份用户（FR-01）；学习记录归属个人账号
model User {
  id        String   @id @default(cuid())
  openid    String   @unique
  nickname  String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authSessions     AuthSession[]
  conversations    Conversation[]
  practiceAttempts PracticeAttempt[]
  collections      CollectionEntry[]
  attachments      Attachment[]
}

/// 应用会话凭据：库存摘要，撤销/过期即失效（设计文档 §11）
model AuthSession {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// 会话容纳多个独立学习对象；activeSubjectId 仅记录当前焦点。
model Conversation {
  id           String    @id @default(cuid())
  userId       String
  title        String    @default("新对话")
  archivedAt   DateTime?
  lastActiveAt DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  activeSubjectId    String?
  learnAll           Boolean             @default(false)
  activeSubject      LearningSubject?    @relation("ActiveSubject", fields: [activeSubjectId], references: [id], onDelete: SetNull)
  subjects           LearningSubject[]   @relation("ConversationSubjects")
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectRevisions   SubjectRevision[]
  processTranscripts ProcessTranscript[]
  messages           Message[]
  progress           LearningProgress[]
  artifacts          Artifact[]
  runs               AgentRun[]
  generationJobs     GenerationJob[]
  collections        CollectionEntry[]

  @@index([userId, lastActiveAt])
  @@index([userId, archivedAt])
}

/// 独立题目/知识范围的稳定身份；编辑只增加 revision，不更换 subjectId。
model LearningSubject {
  id             String @id @default(cuid())
  conversationId String
  order          Int
  createdAt      DateTime @default(now())
  conversation Conversation @relation("ConversationSubjects", fields: [conversationId], references: [id], onDelete: Cascade)
  activeIn     Conversation[] @relation("ActiveSubject")
  revisions    SubjectRevision[]
  progress     LearningProgress?
  messages     Message[]
  collections  CollectionEntry[]
  runs         AgentRun[]
  jobs         GenerationJob[]

  @@unique([conversationId, order])
}

/// 学习对象版本（设计文档 §3.1 / §9）：题目更新创建新版本，旧材料继续指向旧版本
model SubjectRevision {
  id                     String      @id @default(cuid())
  conversationId         String
  subjectId              String
  subject                LearningSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  version                Int
  type                   SubjectType
  /// 题干或知识点内容（结构化 JSON：文本、LaTeX、图形条件、澄清范围）
  content                Json
  /// 关联知识点标签（可参与错题本搜索）
  tags                   String[]    @default([])
  /// 小问列表与当前选择的小问
  subquestions           Json?
  activeSubquestionIndex Int?
  /// 学生对照原图确认的时间；确认前不按未核实条件生成解答（FR-03）
  confirmedAt            DateTime?
  originAttachmentId     String?
  /// 带来源的对象版本教学进展；与页面定位分离，不继承到新题干版本。
  teachingState          Json?
  contextSummaries       ContextSummary[]
  teachingMemories       TeachingMemory[]
  learningRoutes         LearningRoute[]
  createdAt              DateTime    @default(now())

  conversation     Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  originAttachment Attachment?         @relation("SubjectOrigin", fields: [originAttachmentId], references: [id])
  artifacts        Artifact[]
  transcripts      ProcessTranscript[]
  messages         Message[]
  runs             AgentRun[]
  jobs             GenerationJob[]
  progress         LearningProgress[]

  @@unique([subjectId, version])
}

/// Bounded rolling memory. Original Message rows remain the source of truth.
model ContextSummary {
  id                   String @id @default(cuid())
  subjectRevisionId    String
  scopeKey             String
  version              Int @default(1)
  body                 Json
  throughMessageId     String
  throughCreatedAt     DateTime
  coveredMessages      Int
  updatedAt            DateTime @updatedAt
  subjectRevision      SubjectRevision @relation(fields: [subjectRevisionId], references: [id], onDelete: Cascade)

  @@unique([subjectRevisionId, scopeKey])
}

/// 解题过程转写：逐步确认后才作纠错依据（FR-04 / 设计文档 §3.1）
model ProcessTranscript {
  id                String   @id @default(cuid())
  conversationId    String
  subjectRevisionId String
  attachmentId      String
  /// 逐段转写步骤
  steps             Json
  /// 学生确认或修正后的步骤状态
  confirmedSteps    Json?
  /// pending | confirming | confirmed
  status            String   @default("pending")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  conversation    Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  subjectRevision SubjectRevision @relation(fields: [subjectRevisionId], references: [id])
  attachment      Attachment      @relation(fields: [attachmentId], references: [id])

  @@index([conversationId])
}

/// 消息：结构化内容；(会话, requestId) 唯一避免重试重复入库（设计文档 §9 数据约束）
model Message {
  id                String        @id @default(cuid())
  conversationId    String
  subjectId         String
  subject           LearningSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  role              MessageRole
  /// 结构化内容块（文本 / 核对卡 / 成果引用 / 失败说明）
  content           Json
  subjectRevisionId String?
  requestId         String?
  status            MessageStatus @default(complete)
  runId             String?
  createdAt         DateTime      @default(now())

  conversation    Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  subjectRevision SubjectRevision? @relation(fields: [subjectRevisionId], references: [id])
  /// 作为某次运行的用户输入消息（§9.1：重试不重复创建用户消息）
  userMessageRuns AgentRun[]       @relation("RunUserMessage")

  @@unique([conversationId, requestId])
  @@index([conversationId, createdAt])
}

/// 每个学习对象一条进度；独立保存阅读/练习定位及输入草稿。
model LearningProgress {
  id                String        @id @default(cuid())
  conversationId    String
  subjectId         String        @unique
  subject           LearningSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  version           Int           @default(0)
  destination       String        @default("chat")
  draft             String        @default("")
  stage             TeachingStage @default(clarifying)
  subjectRevisionId String?
  currentArtifactId String?       @unique
  currentSectionId  String?
  currentAttemptId  String?
  currentExerciseId String?
  updatedAt         DateTime      @updatedAt

  conversation    Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  subjectRevision SubjectRevision? @relation(fields: [subjectRevisionId], references: [id])
  currentArtifact Artifact?        @relation("CurrentArtifact", fields: [currentArtifactId], references: [id])
}

/// 成果材料：讲义或题组；发布后不修改，修订生成新版本（设计文档 §9 数据约束）
model Artifact {
  id                String        @id @default(cuid())
  conversationId    String
  subjectRevisionId String
  type              ArtifactType
  version           Int
  /// 结构化讲义（章节/段落/配图引用）或题组说明
  content           Json
  publishStatus     PublishStatus @default(generating)
  jobId             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  conversation    Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  subjectRevision SubjectRevision   @relation(fields: [subjectRevisionId], references: [id])
  currentProgress LearningProgress? @relation("CurrentArtifact")
  exercises       Exercise[]
  attempts        PracticeAttempt[]

  @@unique([conversationId, subjectRevisionId, type, version])
  @@index([conversationId])
}

/// 题组单题（FR-06）；题干侧与答案侧由接口分别投影，作答前不下发答案（设计文档 §8.2）
model Exercise {
  id         String @id @default(cuid())
  artifactId String
  order      Int
  stem       String
  topic      String
  difficulty String
  purpose    String
  answer     String
  analysis   String

  artifact Artifact         @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  answers  PracticeAnswer[]

  @@unique([artifactId, order])
}

/// 练习轮次（FR-07 / FR-08）：重做创建新轮次，历史轮次只读
model PracticeAttempt {
  id                String        @id @default(cuid())
  artifactId        String
  userId            String
  /// 本轮所选题目（全部或需巩固题）
  exerciseIds       Json
  stage             PracticeStage @default(intro)
  currentExerciseId String?
  redoOfAttemptId   String?
  redoRequestId     String?
  redoMode          String?
  submittedAt       DateTime?
  completedAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  artifact Artifact         @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers  PracticeAnswer[]

  @@index([userId, createdAt])
  @@index([artifactId, userId])
  @@unique([userId, redoRequestId])
}

/// 逐题作答：(轮次, 题目) 唯一，草稿更新用该组合定位；重做不覆盖旧轮次
model PracticeAnswer {
  id               String    @id @default(cuid())
  attemptId        String
  exerciseId       String
  textDraft        String?
  photoIds         String[]  @default([])
  markedUnknown    Boolean   @default(false)
  hintsUsed        Int       @default(0)
  solutionViewedAt DateTime?
  selfEval         SelfEval?
  /// 草稿递增版本：服务端拒绝旧草稿覆盖新草稿（设计文档 §10）
  draftVersion     Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  attempt  PracticeAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  exercise Exercise        @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([attemptId, exerciseId])
}

/// 对象级收藏；软取消保留笔记和复习状态。
model CollectionEntry {
  id             String       @id @default(cuid())
  userId         String
  conversationId String
  subjectId      String
  subject        LearningSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  removedAt      DateTime?
  note           String?
  reviewStatus   ReviewStatus @default(to_review)
  collectedAt    DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectId])
  @@index([userId, reviewStatus])
}

/// 附件：原图与压缩预览分别保留（设计文档 §4）
model Attachment {
  id               String            @id @default(cuid())
  userId           String
  objectKey        String
  previewObjectKey String?
  purpose          AttachmentPurpose
  format           String
  size             Int
  /// Existing attachments remain ready; new uploads explicitly start pending.
  status           String            @default("ready")
  storageProvider  String            @default("legacy")
  uploadExpiresAt  DateTime?
  scope            Json?
  createdAt        DateTime          @default(now())

  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectRevisions SubjectRevision[]   @relation("SubjectOrigin")
  transcripts      ProcessTranscript[]

  @@index([userId, status])
}

/// 一次 Agent 运行（设计文档 §4.3 / §4.11 / §9.1）：任务记录、协议快照、分项计数与租约
model AgentRun {
  id                String    @id @default(cuid())
  subjectId         String
  subject           LearningSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  conversationId    String
  subjectRevisionId String?
  requestId         String
  /// running | waiting_job | waiting_user | completed | failed | cancelled（§4.3）
  status            String    @default("running")
  promptVersion     String
  /// 学生目标与已完成成果引用（TaskFrame，§4.3）
  taskFrame         Json?
  /// 恢复所需的最小工具协议快照（ModelMessage[]，§4.13）
  protocol          Json?
  /// 待执行工具批次（pendingBatch，§4.12）
  pendingBatch      Json?
  /// 等待中的材料任务引用（waiting_job 时非空）
  waitingJobIds     String[]  @default([])
  /// 分项计数：决策步骤、工具往返、工具执行、各类模型请求、无进展检测（§4.7）
  counters          Json?
  /// 权限与焦点快照（TurnPolicy，§4.6）
  policySnapshot    Json?
  inputDigest       String?
  /// 整项目标截止时间；后台等待计入且恢复不重置（§4.7）
  deadlineAt        DateTime?
  retryOfRunId      String?
  userMessageId     String?
  /// 执行租约：驱动器原子领取，过期可重新领取
  leaseBy           String?
  leaseUntil        DateTime?
  usage             Json?
  error             Json?
  startedAt         DateTime  @default(now())
  finishedAt        DateTime?

  conversation    Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  subjectRevision SubjectRevision? @relation(fields: [subjectRevisionId], references: [id])
  userMessage     Message?         @relation("RunUserMessage", fields: [userMessageId], references: [id])
  toolExecutions  ToolExecution[]
  jobs            GenerationJob[]

  @@unique([conversationId, requestId])
  @@index([conversationId, startedAt])
  @@index([status, leaseUntil])
}

/// 工具执行记录（设计文档 §4.12 / §9.1）：批次顺序、toolCallId 配对、幂等与结果引用
model ToolExecution {
  id             String   @id @default(cuid())
  runId          String
  decisionId     String
  toolCallId     String
  tool           String
  batchOrder     Int
  /// pending | running | succeeded | failed | deferred | cancelled
  status         String   @default("pending")
  idempotencyKey String?  @unique
  paramsDigest   Json?
  resultRef      Json?
  error          Json?
  durationMs     Int?
  jobId          String?
  createdAt      DateTime @default(now())

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, toolCallId])
  @@index([runId, decisionId])
}

/// 长生成任务（设计文档 §8.3 / §8.4 / §9.1）：固定输入快照 + 租约 + 检查点
model GenerationJob {
  id                String    @id @default(cuid())
  runId             String?
  /// lesson | exercise_set | illustration
  type              String
  subjectId         String
  subject           LearningSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  conversationId    String
  subjectRevisionId String?
  status            JobStatus @default(queued)
  /// 当前步骤描述，如「生成正文」「生成配图」「复核」
  step              String?
  resultArtifactId  String?
  /// 创建时固定的输入快照：目标、段落、来源材料与权限范围（§9.1，worker 不从当前状态重建输入）
  payload           Json?
  /// 任务内部模型调用计数与消耗（§8.4）
  counters          Json?
  deadlineAt        DateTime?
  /// 正文等中间检查点，仅图片步骤失败时可复用（§8.4）
  draftCheckpoint   Json?
  retryOfJobId      String?
  /// 幂等标识唯一：同一工具执行只产生一个任务
  idempotencyKey    String?   @unique
  attempts          Int       @default(0)
  error             Json?
  leasedBy          String?
  leasedUntil       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  conversation    Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  subjectRevision SubjectRevision? @relation(fields: [subjectRevisionId], references: [id])
  run             AgentRun?        @relation(fields: [runId], references: [id])

  @@index([status, createdAt])
}


/// Object-scoped teaching evidence. Lifecycle history is retained, never a student profile.
model TeachingMemory {
  id                String @id @default(cuid())
  subjectRevisionId String
  scope             Json
  scopeKey          String
  kind              String
  text              String
  sourceKind        String
  evidence          Json
  status            String @default("candidate")
  supersedesId      String?
  containsSolution  Boolean @default(false)
  verificationRef   String?
  version           Int @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  subjectRevision   SubjectRevision @relation(fields: [subjectRevisionId], references: [id], onDelete: Cascade)
  @@index([subjectRevisionId, status, scopeKey])
}

/// Short, evidence-based companion route. It is separate from navigation and formal practice.
model LearningRoute {
  id                    String               @id @default(cuid())
  subjectRevisionId     String
  goal                  String
  status                String               @default("active")
  version               Int                  @default(1)
  currentNodeId         String?
  contentProfileId      String
  contentProfileVersion String
  sourceMessageId       String
  sourceQuote           String
  sourceRunId           String               @unique
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  subjectRevision       SubjectRevision      @relation(fields: [subjectRevisionId], references: [id], onDelete: Cascade)
  nodes                 LearningRouteNode[]
  events                LearningRouteEvent[]

  @@index([subjectRevisionId, createdAt])
}

model LearningRouteNode {
  id            String          @id @default(cuid())
  routeId       String
  key           String
  position      Int
  objective     String
  prerequisites String[]        @default([])
  status        String          @default("pending")
  version       Int             @default(1)
  passCriteria  Json
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  route         LearningRoute   @relation(fields: [routeId], references: [id], onDelete: Cascade)
  checks        LearningCheck[]

  @@unique([routeId, key])
  @@unique([routeId, position])
}

model LearningCheck {
  id              String                    @id @default(cuid())
  nodeId          String
  sourceRunId     String                    @unique
  issuedMessageId String
  prompt          String
  taskKind        String
  rubricVersion   String
  criteria        Json
  supportLevel    String                    @default("independent")
  /// active | superseded; old evidence is retained when a node is revisited.
  status          String                    @default("active")
  createdAt       DateTime                  @default(now())
  node            LearningRouteNode         @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  evaluations     LearningCheckEvaluation[]

  @@index([nodeId, createdAt])
}

/// Evaluations are append-only; an uncertain result never becomes an invented score.
model LearningCheckEvaluation {
  id               String        @id @default(cuid())
  checkId          String
  runId            String
  attemptMessageId String
  answerSnapshot   String
  evaluation       String
  supportLevel     String
  criteriaResults  Json
  createdAt        DateTime      @default(now())
  check            LearningCheck @relation(fields: [checkId], references: [id], onDelete: Cascade)

  @@unique([checkId, runId])
  @@unique([checkId, attemptMessageId])
}

model LearningRouteEvent {
  id              String        @id @default(cuid())
  routeId         String
  version         Int
  requestId       String        @unique
  sourceMessageId String?
  changes         Json
  createdAt       DateTime      @default(now())
  route           LearningRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@unique([routeId, version])
}
