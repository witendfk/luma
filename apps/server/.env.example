# ---- 数据库 ----
# 本地开发可用 docker compose up -d postgres 后使用：
DATABASE_URL="postgresql://luma:luma_dev_password@localhost:5432/luma?schema=public"

# ---- GPT 模型（服务端统一配置，密钥不下发小程序，AC-18）----
OPENAI_API_KEY=
# 如经代理/网关访问 GPT，填写兼容 OpenAI 协议的地址
OPENAI_BASE_URL=
LUMA_MODEL_ID=gpt-6.1-sol
# 图片生成与教学对话为独立模型能力，网关需单独支持
LUMA_IMAGE_MODEL_ID=gpt-image-1
IMAGE_REQUEST_MS=180000

# ---- 微信小程序（FR-01）----
WECHAT_APPID=
WECHAT_APP_SECRET=
# 开发模式：置 1 时 code 形如 dev:<openid> 可跳过微信校验，仅限本机联调
LUMA_DEV_FAKE_LOGIN=false

# ---- 应用会话凭据 ----
SESSION_TTL_DAYS=30

# ---- 对象存储（腾讯云 COS）----
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-guangzhou

# ---- Agent 运行保护上限（设计文档 §4.7：分项计数，可配置；正式默认值待实测调整）----
MAX_MODEL_REQUESTS=24
MAX_RUN_TOKENS=100000
CONTEXT_INPUT_TOKENS=12000
MODEL_OUTPUT_TOKENS=4096
MODEL_REQUEST_MS=90000
MAX_DECISIONS=12
MAX_TOOL_ROUNDS=6
MAX_TOOL_EXECUTIONS=10
MODEL_MAX_CORRECTIONS=1
RUN_LEASE_MS=120000
TURN_TOTAL_MS=600000
JOB_TOTAL_MS=300000

# ---- 后台任务（设计文档 §8.3）----
JOB_POLL_INTERVAL_MS=2000
JOB_LEASE_MS=900000
# 置 1 时讲义/题组任务产出占位内容，便于未配置模型时联调前端
LUMA_MOCK_AGENT=false
